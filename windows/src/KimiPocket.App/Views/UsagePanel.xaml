<UserControl x:Class="KimiPocket.App.Views.UsagePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:KimiPocket.App.Controls" UseLayoutRounding="True">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Bool"/></UserControl.Resources>
 <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="14" MinHeight="376">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="19,19,19,5">
 <StackPanel>
  <TextBlock Text="Kimi Pocket" FontSize="14" FontWeight="SemiBold" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
  <TextBlock Text="{Binding PlanLine}" Foreground="{DynamicResource Secondary}" FontSize="11" LineHeight="16" LineStackingStrategy="BlockLineHeight" Margin="0,4,0,0"/>
  <TextBlock Text="5 小时额度" Foreground="{DynamicResource Secondary}" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight" Margin="0,20,0,0"/>
  <TextBlock FontFamily="Segoe UI" LineHeight="64" LineStackingStrategy="BlockLineHeight" AutomationProperties.Name="{Binding RollingName}"><Run Text="{Binding HeroNumber,Mode=OneWay}" FontSize="52"/><Run Text="{Binding HeroSuffix,Mode=OneWay}" FontSize="23"/><Run Text="  剩余" FontSize="11" Foreground="{DynamicResource Secondary}"/></TextBlock>
  <TextBlock Text="{Binding HeroWarning}" Visibility="{Binding HasWarning,Converter={StaticResource Bool}}" Foreground="{DynamicResource Secondary}" FontSize="11" Margin="0,0,0,6"/>
  <local:QuotaBar Ratio="{Binding RollingRatio}" Height="5" Margin="0,7,0,0" AutomationProperties.Name="{Binding RollingName}"/>
  <TextBlock Text="{Binding RollingReset}" Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="16" LineStackingStrategy="BlockLineHeight" Margin="0,10,0,0"/>
  <Border Height="1" Background="{DynamicResource Edge}" Margin="0,17,0,0"/>
  <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="本周额度" Foreground="{DynamicResource Secondary}" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight"/><TextBlock Grid.Column="1" Text="{Binding WeeklyText}" FontSize="12"/></Grid>
  <local:QuotaBar Ratio="{Binding WeeklyRatio}" Segments="7" Height="5" Margin="0,9,0,0" AutomationProperties.Name="{Binding WeeklyText,StringFormat=本周额度，{0}}"/>
  <TextBlock Text="{Binding WeeklyReset}" Foreground="{DynamicResource Muted}" FontSize="11" LineHeight="16" LineStackingStrategy="BlockLineHeight" Margin="0,8,0,0"/>
  <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="套餐总额度" Foreground="{DynamicResource Secondary}" FontSize="12" LineHeight="18" LineStackingStrategy="BlockLineHeight"/><TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="12"/></Grid>
  <local:QuotaBar Ratio="{Binding TotalRatio}" Segments="4" Height="5" Margin="0,6,0,0" AutomationProperties.Name="{Binding TotalText,StringFormat=套餐总额度，{0}}"/>
  <TextBlock Text="{Binding Message}" Visibility="{Binding HasMessage,Converter={StaticResource Bool}}" Foreground="{DynamicResource Secondary}" FontSize="11" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
  <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding Footer}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
   <Button x:Name="RefreshButton" Grid.Column="1" Click="RefreshClick" IsEnabled="{Binding CanRefresh}" BorderThickness="0" Padding="5" ToolTip="刷新额度" AutomationProperties.Name="刷新额度"><Path Data="M 13,4 A 7,7 0 1 0 14,12 M 13,0 L 13,5 L 8,5" Stroke="{DynamicResource Secondary}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform"/></Button>
   <Button x:Name="SettingsButton" Grid.Column="3" Click="SettingsClick" BorderThickness="0" Padding="5" ToolTip="设置" AutomationProperties.Name="打开设置"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Secondary}"/></Button>
  </Grid>
 </StackPanel>
 </ScrollViewer></Border>
</UserControl>
